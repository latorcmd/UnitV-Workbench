{
  "name": "unitv-browser-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "test": "node --test tests/*.test.js",
    "prepare-runtime": "node scripts/copy-runtime.mjs",
    "build": "node scripts/clean-dist.mjs && npm run prepare-runtime && vite build --configLoader runner && node scripts/copy-worker.mjs && node scripts/cleanup-runtime.mjs && node scripts/copy-offline-package.mjs",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "^0.16.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "fflate": "^0.8.3",
    "pyodide": "^0.28.3"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
